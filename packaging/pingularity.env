# Configuration for the pingularity systemd service.
# Add daemon flags here; the systemd unit expands them onto `pingularity run`.
# Native Linux services only: the Docker/compose images ignore this variable -
# there, pass flags after the image name (compose: under `command:`).
# Example (bind the dashboard to loopback only):
#   PINGULARITY_OPTS="-listen 127.0.0.1:9000"
PINGULARITY_OPTS=""
